(defcfg
  process-unmapped-keys yes
  macos-dev-names-include (
    "Apple Internal Keyboard / Trackpad"
  )
  ;; If any key was pressed within 150ms, resolve tap-hold as tap immediately.
  ;; Prevents accidental modifier activation during fast typing.
  tap-hold-require-prior-idle 150
)

(defsrc
  esc     f1      f2      f3      f4      f5    f6    f7    f8    f9    f10    f11    f12
  grv     1       2       3      4       5       6       7       8     9     0      -      =    bspc
  tab     q       w       e      r       t       y       u       i     o     p      [      ]    \
  caps    a       s       d      f       g       h       j       k     l     ;      '      ret
  lsft    z       x       c      v       b       n       m       ,     .     /      rsft
  fn  lctl    lalt    lmet                  spc                      rmet  ralt  left   down   up   rght
)

(platform (macos)
  ;; Only on macos, use command arrows to jump/delete words
  ;; because command is used for so many other things
  ;; and it's weird that these cases use alt.
  (defoverrides
    (lmet bspc) (lalt bspc)
    (lmet left) (lalt left)
    (lmet right) (lalt right)
  )
)

;; Physical-hand assignments for tap-hold-opposite-hand.
;; Same-hand rolls resolve as taps; opposite-hand keys activate the hold.
(defhands
  (left
    q w e r t
    a s d f g
    z x c v b
  )
  (right
    y u i o p
    h j k l ;
    n m , . /
  )
)

(defvar
  ;; Keep the existing timings for layer-tap aliases.
  tap-time 200
  layer-hold-time 180
  hrm-hold-time 180
  hrm-prior-idle 220
  hrm-repress 200
)

(defalias

  ;; Home-row mods: same-hand rolls tap; opposite-hand chords hold.
  a (tap-hold-opposite-hand $hrm-hold-time a lmet
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  s (tap-hold-opposite-hand $hrm-hold-time s lalt
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  d (tap-hold-opposite-hand $hrm-hold-time d lctl
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  f (tap-hold-opposite-hand $hrm-hold-time f lsft
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  j (tap-hold-opposite-hand $hrm-hold-time j rsft
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  k (tap-hold-opposite-hand $hrm-hold-time k rctl
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  l (tap-hold-opposite-hand $hrm-hold-time l ralt
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  ; (tap-hold-opposite-hand $hrm-hold-time ; rmet
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle $hrm-prior-idle)
    (tap-repress-timeout $hrm-repress))

  snav  (tap-hold 200 200 spc (layer-while-held navigation))

  ;; Preserve the existing advanced behaviour for layer-tap keys.
  c_syms (tap-hold-opposite-hand-release
    $layer-hold-time c (layer-while-held symbols)
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle 180)
    (tap-repress-timeout $tap-time))

   m_syms (tap-hold-opposite-hand-release
    $layer-hold-time m (layer-while-held symbols)
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle 180)
    (tap-repress-timeout $tap-time))

  v_num (tap-hold-opposite-hand-release
    $layer-hold-time v (layer-while-held numbers)
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle 180)
    (tap-repress-timeout $tap-time))

  n_fn (tap-hold-opposite-hand-release
    $layer-hold-time n (layer-while-held fn)
    (same-hand tap)
    (unknown-hand hold)
    (timeout hold)
    (require-prior-idle 220)
    (tap-repress-timeout $tap-time))

  vspc (tap-hold 200 200 v spc)

  c_esc (tap-hold 200 200 esc lctl)

  t_m (tap-hold 200 200 tab (layer-while-held mouse))

  fn (tap-hold 200 200 fn (layer-while-held function))

  hyper (multi lctl lsft lalt lmet)
  meh   (multi lctl lsft lalt)

  cw (caps-word 2000)
)

(defvirtualkeys
  mouse-h (layer-while-held mouse)
)

(defalias
  mwu (mwheel-up 50 120)
  mwd (mwheel-down 50 120)
  mwl (mwheel-left 50 120)
  mwr (mwheel-right 50 120)

  ms↑ (movemouse-up 1 1)
  ms← (movemouse-left 1 1)
  ms↓ (movemouse-down 1 1)
  ms→ (movemouse-right 1 1)

  ma↑ (movemouse-accel-up 1 1000 1 6)
  ma← (movemouse-accel-left 1 1000 1 6)
  ma↓ (movemouse-accel-down 1 1000 1 6)
  ma→ (movemouse-accel-right 1 1000 1 6)
  ;; mouse click extended time out for double tap
  mdbt (hold-for-duration 500 mouse-h)
  mbl (multi
       mlft
       @mdbt
  )
  mbm (multi
       mmid
       @mdbt
  )
  mbr (multi
       mrgt
       @mdbt
  )
)

(deflayer base
  _      f1      f2      f3      f4      f5    f6    f7    f8    f9    f10    f11    f12
  _      _         _         _          _         _    _        _          _         _         _         _    _    _
  @t_m      _         _         _          _         _    _        _          _         _         _         _    _    _
  @c_esc @a    @s    @d     @f    _    _        @j     @k    @l    @;    _    _
  _      _         _         @c_syms    @v_num    _    @n_fn    @m_syms    _         _         _        _
  @fn   _    @meh       _             @snav                         @meh    _   _      _        _       _
)

(deflayer nomods
  esc     f1      f2      f3      f4      f5    f6    f7    f8    f9    f10    f11    f12
  grv     1       2       3      4       5       6       7       8     9     0      -      =    bspc
  tab     q       w       e      r       t       y       u       i     o     p      [      ]    \
  caps    a       s       d      f       g       h       j       k     l     ;      '      ret
  lsft    z       x       c      v       b       n       m       ,     .     /      rsft
  @fn lctl    lalt    lmet                  spc                      rmet  ralt  left   down   up   rght
)

(deflayer empty
  _    _      _      _      _    _     _   _     _    _    _   _  _
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _
  _   _      _       _                _                     _    _    _    _  _   _
)

(deflayer function
  _    brdn      brup      bldn      blup    M-S-4       M-S-5    prev       pp        next      mute     vold volu
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _
  _   _      _       _                _                     _    _    _    _  _   _
)

(deflayer navigation
  _      _       _       _       _      _    _       _       _       _        _    _    _
  lrld      C-A-S-1     C-A-S-2     C-A-S-3     C-A-S-4    C-A-S-5   C-A-S-6     C-A-S-7     C-A-S-8     C-A-S-9      C-A-S-0    _    _    _
  _      C-A-S-q   C-A-S-w   C-S-tab C-tab     C-A-S-x         caps      home   up   end      _    _    _    _
  esc    lmet    lalt    lctl    lsft      C-A-S-x            bspc    left    down   right    @cw    _    M-ret
  -      M-z M-x M-c M-v  C-A-S-spc  del     pgdn    pgup    _    _    _
  _   _      C-A-S-spc       M-spc                       _                     _    _    _    _   _   _
)

(deflayer numbers
  _    _       _       _       _      _    _       _       _       _        _    _    _
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    S-8    7    8    9    =    _    _    _
  _    lmet    lalt    lctl    lsft    _    +    4    5    6    -    _    _
  _    _       _       _       _       _    /    1    2    3    .    ,
  _  _    _       _                0                     _    _    _    _  _   _
)

(deflayer symbols
  _    _       _       _       _      _    _       _       _       _        _    _    _
  _    _    _    _     _     _    _    _    _    _    _      _    _    _
  _    S-1    S-2    S-[     S-]     S-5    '    S-6    S-7    S-4    ret    _    _    _
  _    ;    S-;    S-9    S-0    =    S-\    S-,    S-.    -    S--      S-'    _
  S-'    \    [    ]     +     _    S-/    S-3    S-8    `    S-`      _
  _   _    _    _              _              _    _    _    _   _  _
)

(deflayer fn
  _      _       _       _       _      _    _       _       _       _        _    _    _
  _      _      _     _     _     _    _    _       _       _       _       _    _    _
  _      f10    f7    f8    f9    _    _    _       _       _       _       _    _    _
  _      f11    f4    f5    f6    _    _    rsft    rctl    lalt    rmet    _    _
  f12    f1     f2    f3    _     _    _    _       _       _       _       _
  _   _      _      _                  _                _     _    _    _       _       _
)

(deflayer mouse
  _    _      _      _      _    _     _   _     _    _    _   _  _
  _    _       _       _       _       _    _    _    _    _    _    _    _    _
  _    _       _       _       _       _    _    @mbm    @ma↑   @mbr    _    _    _    _
  _    _       _       _       _       _    @mwl    @ma← @ma↓  @ma→    @mwr    _    _
  _    _       _       _       _       _    @mwl    @mwu    @mwd    @mwr    _    _
  _   _      _       _                @mbl                     _    _    _    _  _   _
)
